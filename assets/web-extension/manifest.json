{
  "manifest_version": 3,
  "name": "gerdr",
  "description": "Lets gerdr follow and steer the web pages it shows, and show its markdown previews.",
  "version": "1",
  "key": "",
  "permissions": ["nativeMessaging", "scripting", "storage", "tabs"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "worker.js" }
}
